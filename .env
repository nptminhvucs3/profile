# Cờ tính năng (đọc lúc build/dev — sửa xong cần chạy lại `npm run dev` hoặc `npm run build`)
#
# Nút chuyển Dark/Light ở góc trên bên phải.
#   false = ẩn nút và khóa giao diện ở Dark Mode (toàn bộ code theme vẫn được giữ)
#   true  = bật lại nút, lưu lựa chọn, theo theme hệ điều hành ở lần truy cập đầu
VITE_THEME_TOGGLE=false
